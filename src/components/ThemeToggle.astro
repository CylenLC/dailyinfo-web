---
// Manual light/dark toggle. The anti-flash bootstrap script lives in
// BaseLayout's <head> (see there); this component only renders the button.
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-label="切换浅色 / 深色主题"
  title="切换浅色 / 深色主题"
>
  <span data-theme-label>主题</span>
</button>
