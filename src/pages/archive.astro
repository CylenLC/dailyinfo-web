---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { CATEGORIES } from '../lib/categories.ts';
import { briefingRoute, dailyRoute } from '../lib/urls.ts';
import { withBase } from '../lib/site.ts';
import { loadSiteContent } from '../lib/content.ts';

const site = await loadSiteContent();
const yearGroups = [...new Set(site.dates.map((date) => date.slice(0, 4)))].map((year) => ({
  year,
  months: [...new Set(site.dates.filter((date) => date.startsWith(year)).map((date) => date.slice(0, 7)))].map(
    (month) => ({ month, dates: site.dates.filter((date) => date.startsWith(month)) }),
  ),
}));
---

<BaseLayout
  title="Archive"
  description="DailyInfo 历史日报归档，按日期与分类组织。"
  path="/archive/"
>
  <div class="page-shell archive-page">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Archive' }]} />
    <header class="page-heading">
      <div>
        <p class="eyebrow">Publication history</p>
        <h1>Archive</h1>
        <p class="page-heading__description">
          按日期浏览历史 DailyInfo 出版物，并快速定位当天各分类简报。
        </p>
      </div>
      <p class="count-block" aria-label={`${site.dates.length} 个发布日期`}>
        <strong>{site.dates.length}</strong>
        <span>Days</span>
      </p>
    </header>

    {yearGroups.length === 0 && <p class="empty-note">暂无历史发布内容。</p>}
    <div class="archive-timeline">
      {yearGroups.map(({ year, months }) => (
        <section class="archive-year" aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`}>{year}</h2>
          {months.map(({ month, dates }) => (
            <section class="archive-month" aria-labelledby={`month-${month}`}>
              <h3 id={`month-${month}`}>{month.slice(5)} 月</h3>
              <div class="archive-days">
                {dates.map((date) => {
                  const briefings = site.briefingsByDate.get(date) ?? [];
                  const total = briefings.reduce((sum, briefing) => sum + briefing.data.item_ids.length, 0);
                  return (
                    <article class="archive-day">
                      <div class="archive-day__date">
                        <time datetime={date}>{date.slice(8)}</time>
                        <div>
                          <a href={withBase(dailyRoute(date))}>{date}</a>
                          <span>{briefings.length} Briefings · {total} Items</span>
                        </div>
                      </div>
                      <ul class="archive-day__categories" aria-label={`${date} 分类简报`}>
                        {CATEGORIES.map((category) => {
                          const briefing = briefings.find((entry) => entry.data.category === category.id);
                          if (!briefing) return null;
                          return (
                            <li>
                              <a
                                href={withBase(briefingRoute(date, category.id))}
                                data-category={category.id}
                              >
                                <span>{category.label}</span>
                                <strong>{briefing.data.item_ids.length}</strong>
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    </article>
                  );
                })}
              </div>
            </section>
          ))}
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
